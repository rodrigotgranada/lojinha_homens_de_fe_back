PORT=3001
# --- ALTERNÂNCIA DE BANCO ---
# true = Conecta ao MongoDB local do notebook (usado em contingência no retiro se a internet cair)
# false = Conecta ao MongoDB remoto na Nuvem (operação padrão do dia a dia com internet)
USE_LOCAL_DB=false

MONGODB_URI_LOCAL=mongodb://localhost:27017/lojinha
MONGODB_URI_CLOUD=mongodb+srv://admin:admin@cluster0.osrtqkn.mongodb.net/lojinha?retryWrites=true&w=majority&appName=Cluster0

# --- CONTINGÊNCIA E SINCRONIZAÇÃO OFFLINE (Para rodar no Notebook Local) ---
# IS_LOCAL_SERVER deve ser 'true' apenas no notebook local do retiro caso queira sincronização contínua de fundo.
# Em desenvolvimento normal, mantenha 'false' para não poluir os logs nem consumir a nuvem a cada 30 segundos.
IS_LOCAL_SERVER=false
REMOTE_API_URL=https://lojinha-homens-de-fe-back.onrender.com
SYNC_INTERVAL_MS=300000

# Firebase Configuration (leave blank or fill to enable Firebase Storage)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_STORAGE_BUCKET=
